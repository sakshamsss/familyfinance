# ==============================================================================
# FamilyFinance — Stock Research, Trade Planner & Family Portfolio
# Environment Configuration (.env.example)
# ==============================================================================

# 1. Security & Access Control (Family Vault Lockscreen PIN)
FAMILY_ACCESS_PIN=0410

# 2. Database Configuration
# Default is local SQLite (Zero-Cost). For cloud persistence, provide Supabase/Neon PostgreSQL URL.
DATABASE_URL=sqlite:///./family_alpha.db

# 3. AI Multi-Agent Advisor (Google AI Studio Free-Tier Configuration)
# Get free-tier key from https://aistudio.google.com/
GEMINI_API_KEY=your_free_google_ai_studio_api_key
PRIMARY_AI_MODEL=gemini-3.8-flash
FALLBACK_AI_MODEL=gemini-3.5-flash-lite

# 4. Secondary US Equities Fallback API (Optional — falls back to Yahoo Finance automatically)
FINNHUB_API_KEY=

# 5. Official NSE MCP Endpoints (Keyless Public Endpoints)
NSE_MCP_BHAVCOPY_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp
NSE_MCP_CM_MARKET_URL=https://mcp.nseindia.in/cmmkt/mcp
NSE_MCP_TIMEOUT_SECONDS=8.0

# 6. Default Family Portfolio Parameters
DEFAULT_FAMILY_CAPITAL_INR=500000
DEFAULT_FAMILY_CAPITAL_USD=25000
DEFAULT_RISK_PER_TRADE_PCT=1.0
MAX_SINGLE_POSITION_ALLOCATION_PCT=18.0
